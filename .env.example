# Ollama runs locally — no API key required
# Make sure Ollama is running: https://ollama.ai
# And the model is pulled: ollama pull llama3.2

# --- Document OCR / PDF generation ---
# Absolute path to the folder containing chapter subfolders (Chap1/, Chap2/, ...)
# DOCUMENT_BASE_PATH=C:\Users\Tchoupo\Documents\Management de project Logiciels

# Tesseract OCR language code (fra = French, eng = English, fra+eng = both)
# OCR_LANGUAGE=fra

# --- Vision LLM (GitHub Models) ---
# Personal Access Token GitHub avec la permission "Models: read"
# Créer sur : github.com → Settings → Developer settings → Personal access tokens
# Requis uniquement pour le mode PDF "vision" (GPT-4o via GitHub Models)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
