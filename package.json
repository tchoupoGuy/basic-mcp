{
  "name": "basic-mcp",
  "version": "1.0.0",
  "description": "build a basic mcp server",
  "repository": {
    "type": "git",
    "url": "https://github.com/tchoupoGuy"
  },
  "license": "MIT",
  "author": "GUY Tchoupo",
  "type": "commonjs",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npx tsx server/main.ts",
    "start:http": "npx tsx server/server-http.ts",
    "start:ui": "concurrently \"npm run start:http\" \"npm run dev --prefix client\"",
    "test": "npm test",
    "electron:build-main": "tsc -p tsconfig.electron.json",
    "electron:build-server": "node scripts/build-server.mjs",
    "electron:dev": "concurrently \"npm run start:http\" \"npm run dev --prefix client\" \"npm run electron:start\"",
    "electron:start": "electron .",
    "electron:rebuild": "electron-rebuild -v 42.0.1",
    "electron:pack": "npm run electron:build-main && npm run electron:build-server && npm run build --prefix client && npm run electron:rebuild && electron-packager . \"Assistant PMP\" --platform=win32 --arch=x64 --out=dist-app --overwrite --electron-version=42.0.1 --no-asar --ignore=\"^/dist-app$\" --ignore=\"^/.git$\" --ignore=\"^/client/src$\" --ignore=\"^/electron$\" --no-prune",
    "electron:dist": "npm run electron:pack"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.75",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/sharp": "^0.31.1",
    "ai": "^6.0.175",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "ollama-ai-provider-v2": "^3.5.0",
    "openai": "^6.37.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@electron/rebuild": "^3.7.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.tchoupo.assistant-pmp",
    "productName": "Assistant PMP",
    "asar": false,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*",
      "node_modules/**/*",
      "server/**/*",
      "output/**/*",
      "tesseract-data/**/*",
      "logs/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "output",
        "to": "output"
      },
      {
        "from": "tesseract-data",
        "to": "tesseract-data"
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "client/public/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
